mns: 1fr}\n}\n.faq-box {border-left: 2px solid #ff5500;padding: 4px 0 4px 14px}\n.faq-box h3 {font-size: 15px;color: #000000;margin-bottom: 6px}\n.faq-box p {font-size: 13px;color: #555555;line-height: 1.5}\n\n/* 底部票根声明 */\n.receipt-stub {margin-top: 48px;padding-top: 16px;border-top: 1px dashed #cccccc;font-size: 12px;color: #888888;display: flex;flex-direction: column;gap: 6px}\n</style><main>\n  <span class=\"tag-line\">服务规格清单与部署索引</span>\n  <h1>低价机场 数据交换与接入指引</h1>\n  <p class=\"lead-intro\">本页面罗列低价机场当前的接入节点计划、客户端适配状态及常见问题解答，请依照业务需求对照办理。</p>\n\n  <div class=\"in-page-links\">\n    <span>跳转项：</span>\n    <a href=\"#timeline\">接入周期</a>\n    <a href=\"#plans\">套餐规格表</a>\n    <a href=\"#clients\">终端支持清单</a>\n    <a href=\"#faq\">常见问题与答复</a>\n  </div>\n\n  <section id=\"timeline\" class=\"timeline-hero\">\n    <div class=\"timeline-step\">\n      <div class=\"timeline-node\"></div>\n      <h2 class=\"timeline-title\">阶段 01: 账号校验与套餐锁定</h2>\n      <p class=\"timeline-desc\">核对预算与周期流量配额，根据月均用量选择适配的基础版、旗舰版或团队版规划。</p>\n    </div>\n    <div class=\"timeline-step\">\n      <div class=\"timeline-node\"></div>\n      <h2 class=\"timeline-title\">阶段 02: 协议密钥生成与节点下发</h2>\n      <p class=\"timeline-desc\">系统基于订阅凭证分发通用格式配置串，无需手动编写路由规则与中继参数。</p>\n    </div>\n    <div class=\"timeline-step\">\n      <div class=\"timeline-node\"></div>\n      <h2 class=\"timeline-title\">阶段 03: 终端导入与网络连通确认</h2>\n      <p class=\"timeline-desc\">将订阅链接粘贴至指定平台的通用代理内核工具，同步节点并执行连通性自检。</p>\n    </div>\n  </section>\n\n  <section id=\"plans\" class=\"receipt-card\">\n    <div class=\"section-head\">\n      <h2>套餐明细与参数对照表</h2>\n      <span class=\"meta-serial\">PLANS-TABLE-V1</span>\n    </div>\n    <div class=\"table-wrapper\">\n      <table class=\"plans-table\">\n        <thead>\n          <tr>\n            <th>对比指标</th>\n            <th>基础版</th>\n            <th class=\"featured-col\">旗舰版 <span class=\"badge-feat\">推荐</span></th>\n            <th>团队版</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td>月付单价</td>\n            <td><span class=\"price-tag\">¥15/月</span></td>\n            <td class=\"featured-col\"><span class=\"price-tag\">¥35/月</span></td>\n            <td><span class=\"price-tag\">¥85/月</span></td>\n          </tr>\n          <tr>\n            <td>年付优惠</td>\n            <td><span class=\"annual-tag\">按年付仅需 ¥150/年</span></td>\n            <td class=\"featured-col\"><span class=\"annual-tag\">按年付仅需 ¥350/年</span></td>\n            <td><span class=\"annual-tag\">按年付仅需 ¥850/年</span></td>\n          </tr>\n          <tr>\n            <td>每月流量配额</td>\n            <td>100GB 极速流量</td>\n            <td class=\"featured-col\">300GB 极速流量</td>\n            <td>1000GB 极速流量</td>\n          </tr>\n          <tr>\n            <td>同时在线设备</td>\n            <td>3 台</td>\n            <td class=\"featured-col\">5 台</td>\n            <td>20 台</td>\n          </tr>\n          <tr>\n            <td>节点范围与解锁</td>\n            <td>普通线路节点池，解锁基础流媒体</td>\n            <td class=\"featured-col\">IPLC 专线游戏加速优化，全节点原生流媒体解锁</td>\n            <td>VIP 专属高带宽节点，支持企业定制路由</td>\n          </tr>\n          <tr>\n            <td>服务保障等级</td>\n            <td>常规工单响应</td>\n            <td class=\"featured-col\">7x24 优先工单支持</td>\n            <td>专属客户经理服务</td>\n          </tr>\n          <tr>\n            <td>快速操作</td>\n            <td><a href=\"#faq\" class=\"action-link\">查看说明</a></td>\n            <td class=\"featured-col\"><a href=\"#faq\" class=\"action-link highlight\">查看说明</a></td>\n            <td><a href=\"#faq\" class=\"action-link\">查看说明</a></td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  <section id=\"clients\" class=\"receipt-card\">\n    <div class=\"section-head\">\n      <h2>客户端配置标准</h2>\n      <span class=\"meta-serial\">CLIENT-COMPAT-LIST</span>\n    </div>\n    <p>低价机场兼容标准 Clash、Sing-box、Shadowrocket 等主流通用协议内核。官方不提供经过篡改的专有客户端安装包，请使用各平台公认的开源或受信代理程序。</p>\n    <div class=\"client-grid\">\n      <div class=\"client-item\">\n        <h3>Windows 环境</h3>\n        <p>支持基于通用协议的开源图形界面客户端，通过一键导入或订阅链接批量获取节点。</p>\n        <span class=\"status-tag\">支持配置文件导入</span>\n      </div>\n      <div class=\"client-item\">\n        <h3>macOS 环境</h3>\n        <p>适配各主流通用内核管理器，支持系统代理与增强模式，满足日常访问与开发分流。</p>\n        <span class=\"status-tag\">支持订阅解析</span>\n      </div>\n      <div class=\"client-item\">\n        <h3>Android 环境</h3>\n        <p>使用标准代理核心客户端，粘贴订阅地址更新后即可在通知栏管理连接状态。</p>\n        <span class=\"status-tag\">标准通用规则</span>\n      </div>\n      <div class=\"client-item\">\n        <h3>iOS / iPadOS 环境</h3>\n        <p>需在相应区域应用商店获取支持订阅格式的网络工具，手动录入订阅地址并授权连接。</p>\n        <span class=\"status-tag\">扫码 / 链接同步</span>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\" class=\"receipt-card\">\n    <div class=\"section-head\">\n      <h2>常见问题解答</h2>\n      <span class=\"meta-serial\">DOC-FAQ-ITEMS</span>\n    </div>\n    <div class=\"faq-two-col\">\n      <article class=\"faq-box\">\n        <h3>1. 购买后如何获取节点信息？</h3>\n        <p>完成开通后，在控制台的“订阅信息”栏目复制订阅地址。将该地址导入受支持的客户端中刷新，即可拉取当前套餐所涵盖的所有节点列表。</p>\n      </article>\n      <article class=\"faq-box\">\n        <h3>2. 超过套餐流量上限会发生什么？</h3>\n        <p>当月流量耗尽后节点将暂停数据传输服务，直到下一个账单周期重置，或通过补购临时数据包恢复通行配额。</p>\n      </article>\n      <article class=\"faq-box\">\n        <h3>3. 什么是设备同时在线限制？</h3>\n        <p>基础版限制 3 台、旗舰版 5 台、团队版 20 台同时建立连接。超出限制可能导致早先连接的设备断开或触发临时限流保护机制。</p>\n      </article>\n      <article class=\"faq-box\">\n        <h3>4. 是否支持退款或变更套餐？</h3>\n        <p>套餐变更遵循补差价原则，已消耗的周期性服务费用不可退还。建议在初次选购时优先根据月付规格评估连接表现。</p>\n      </article>\n    </div>\n  </section>\n\n  <footer class=\"receipt-stub\">\n    <p>凭证代码: #LC-DOC-2025 // 低价机场 规格清单公开页面</p>\n    <p>声明: 本页面仅用于技术参数与服务清单展示，网络服务请在遵守当地法律法规的前提下合规使用。</p>\n  </footer>\n</main>",
